// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ──────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum Grade {
  K
  G1
  G2
  G3
  G4
  G5
  G6
  G7
  G8
  G9
  G10
  G11
  G12
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Parental/guardian consent audit trail for child accounts.
  // consentGiven:  true once a responsible adult accepted the Privacy Notice.
  // consentAt:     timestamp of that acceptance (UTC).
  // consentAgent:  User-Agent string at the time of consent (for audit purposes only).
  consentGiven  Boolean   @default(false)
  consentAt     DateTime?
  consentAgent  String?   @db.Text

  accounts Account[]
  sessions Session[]

  // Student-specific
  grade        Grade?
  studentLevel Int    @default(1) // 1–10 adaptive level
  totalStars   Int    @default(0)
  totalXP      Int    @default(0)
  streakDays   Int    @default(0)
  lastActiveAt DateTime?
  // true once the child finished or skipped the first placement quest
  placementDone Boolean @default(false)

  // Relations
  classroomsAsStudent Enrollment[]
  classroomsAsTeacher Classroom[]     @relation("TeacherClassrooms")
  children            ParentChild[]   @relation("ParentChildren")
  parents             ParentChild[]   @relation("ChildParents")
  progress            Progress[]
  badges              UserBadge[]
  exerciseSessions    ExerciseSession[]
  notifications       Notification[]
  practiceGoals       PracticeGoal[]
  skillStates         StudentSkillState[]
  skillAttempts       SkillAttempt[]
  skillAssessments    SkillAssessment[]
}

model ParentChild {
  id        String @id @default(cuid())
  parentId  String
  childId   String
  parent    User   @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  child     User   @relation("ChildParents", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

// ─── Classrooms ─────────────────────────────────────────────────────────────

model Classroom {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique @default(cuid())
  teacherId String
  grade     Grade
  createdAt DateTime @default(now())

  teacher     User         @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  enrollments Enrollment[]
}

model Enrollment {
  id          String   @id @default(cuid())
  studentId   String
  classroomId String
  joinedAt    DateTime @default(now())

  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([studentId, classroomId])
}

// ─── Subjects & Exercises ───────────────────────────────────────────────────

enum Subject {
  MATH
  READING
  SCIENCE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Topic {
  id          String    @id @default(cuid())
  subject     Subject
  name        String
  description String?
  icon        String?
  order       Int       @default(0)
  exercises   Exercise[]
  progress    Progress[]
  goals       PracticeGoal[]
}

model Exercise {
  id           String     @id @default(cuid())
  topicId      String
  title        String
  instructions String
  type         String     // "multiple_choice" | "fill_blank" | "word_problem" | "reading_comp"
  difficulty   Difficulty
  level        Int        // 1–10, used for adaptive algorithm
  data         Json       // question payload (options, answer, passage, etc.)
  xpReward     Int        @default(10)
  starReward   Int        @default(1)
  active       Boolean    @default(true) // false = retired from the current question bank
  createdAt    DateTime   @default(now())

  topic    Topic             @relation(fields: [topicId], references: [id])
  sessions ExerciseSession[]
}

// ─── Progress & Sessions ────────────────────────────────────────────────────

model ExerciseSession {
  id          String   @id @default(cuid())
  userId      String
  exerciseId  String
  correct     Boolean
  timeTaken   Int      // seconds
  xpEarned    Int      @default(0)
  starsEarned Int      @default(0)
  completedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  topicId      String
  level        Int      @default(1)
  correctCount Int      @default(0)
  totalCount   Int      @default(0)
  mastered     Boolean  @default(false)
  sinceChange  Int      @default(0) // answers since the level last changed (stops runaway level-ups)
  lessonsSeen  Int      @default(0) // how many "Learn first" lessons for this topic the child has read
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
}

// ─── Rewards ────────────────────────────────────────────────────────────────

model Badge {
  id          String    @id @default(cuid())
  name        String
  description String
  icon        String    // emoji or icon name
  condition   String    // e.g., "streak_7", "xp_500", "math_mastered"
  xpThreshold Int?
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   // "badge", "streak", "level_up", "message"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Practice time (set by a parent, per child and skill) ────────────────────

// ─── Shared rate-limit store ─────────────────────────────────────────────────
// Replaces the per-process in-memory limiter so limits hold across serverless
// instances. Rows are cheap and cleaned up by the limiter itself.
model RateLimitEntry {
  id        String   @id  // "prefix:key" e.g. "reg:1.2.3.4" or "login:user@example.com"
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

// ─── Fine-grained Skill Mastery ──────────────────────────────────────────────
//
// These models extend the existing broad topic-level Progress record to support
// individual learning skills, evidence-of-mastery tracking and spaced review.
//
// Migration safety:
//   • All new models are purely additive — no existing column is altered.
//   • No existing row is modified by adding these tables.
//   • LearningSkill rows are seeded (upserted) by the skill-mastery seeder.
//   • StudentSkillState rows are created only when a child first encounters a skill.

// A single teachable learning skill (e.g. "recognise the /sh/ digraph").
model LearningSkill {
  id              String   @id  // stable string key e.g. "phonics-sh-digraph"
  subject         Subject
  name            String   // short display name, e.g. "SH Digraph"
  objective       String   // full learning objective
  stageMin        Int      @default(1)  // lowest grade-equivalent stage this skill targets (K=0, G1=1, …)
  stageMax        Int      @default(2)  // highest grade-equivalent stage
  order           Int      @default(0)  // within-subject sequencing order

  prerequisites   SkillPrerequisite[] @relation("SkillRequires")
  requiredBy      SkillPrerequisite[] @relation("SkillRequiredBy")
  studentStates   StudentSkillState[]
  assessments     SkillAssessment[]
  attempts        SkillAttempt[]
}

// Which skills must be demonstrated before a skill can be formally introduced.
model SkillPrerequisite {
  id            String       @id @default(cuid())
  skillId       String
  requiresId    String

  skill         LearningSkill @relation("SkillRequires",   fields: [skillId],    references: [id], onDelete: Cascade)
  requires      LearningSkill @relation("SkillRequiredBy", fields: [requiresId], references: [id], onDelete: Cascade)

  @@unique([skillId, requiresId])
}

// The learning-stage pipeline for a student's work on a single skill.
enum SkillStage {
  TEACH             // explicit instruction shown — child has not yet practised
  GUIDED_PRACTICE   // supported practice with hints freely available
  INDEPENDENT       // practice without hints; performance is observed
  MASTERY_CHECK     // assessment using unseen items; no hints
  MASTERED          // mastery check passed
  REVIEW            // periodic spaced review to maintain retention
}

// The current state of one skill for one student.
model StudentSkillState {
  id              String     @id @default(cuid())
  userId          String
  skillId         String
  stage           SkillStage @default(TEACH)
  // Counts used to advance through the pipeline
  guidedCorrect   Int        @default(0)
  guidedTotal     Int        @default(0)
  independentCorrect Int     @default(0)
  independentTotal   Int     @default(0)
  masteryCheckCorrect Int    @default(0)
  masteryCheckTotal   Int    @default(0)
  masteredAt      DateTime?
  nextReviewAt    DateTime?
  reviewInterval  Int        @default(1)   // days until next review
  updatedAt       DateTime   @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill           LearningSkill @relation(fields: [skillId], references: [id])
  attempts        SkillAttempt[]

  @@unique([userId, skillId])
}

// One attempt at a question during a skill session.
// Linked to the existing ExerciseSession via exerciseSessionId so history is never fabricated.
model SkillAttempt {
  id                String     @id @default(cuid())
  userId            String
  skillId           String
  exerciseSessionId String?    // FK to ExerciseSession — null only for offline attempts
  stage             SkillStage // the pipeline stage when this attempt was made
  correct           Boolean
  usedHint          Boolean    @default(false)
  isUnseenItem      Boolean    @default(false)  // true when this is a mastery-check item
  attemptedAt       DateTime   @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill             LearningSkill @relation(fields: [skillId], references: [id])

  @@index([userId, skillId])
  @@index([userId, attemptedAt])
}

// A formal assessment event — created when a student completes a MASTERY_CHECK stage.
model SkillAssessment {
  id              String     @id @default(cuid())
  userId          String
  skillId         String
  correct         Int
  total           Int
  passed          Boolean
  assessedAt      DateTime   @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill           LearningSkill @relation(fields: [skillId], references: [id])
}

// A versioned snapshot of the curriculum so that changes to skill definitions
// can be tracked and old learning records can be understood in context.
model ContentCurriculumVersion {
  id          String   @id @default(cuid())
  version     String   @unique  // semver e.g. "1.0.0"
  description String
  publishedAt DateTime @default(now())
  active      Boolean  @default(true)  // only one version is active at a time
}

model PracticeGoal {
  id        String   @id @default(cuid())
  childId   String
  topicId   String
  minutes   Int      @default(10) // daily practice minutes for this skill; 0 = rest today
  updatedAt DateTime @updatedAt

  child User  @relation(fields: [childId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([childId, topicId])
}
